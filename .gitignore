.env
node_modules/
dist/

# Dado de sessão: efêmero e com dado de espectador. Nunca versionado (11_SEGURANCA).
data/sessoes/*
!data/sessoes/.gitkeep.md

# Cache de ícone baixado da TikTok e do Roblox: gerado, nunca versionado.
data/icones/*
!data/icones/.gitkeep.md
data/icones-itens/*
!data/icones-itens/.gitkeep.md

# Catálogo real, coletado da live. A semente versionada é catalogo-presentes.seed.json.
data/catalogo-presentes.json

# Espelho gerado a partir do índice Luau, nunca editado à mão (04_MODELAGEM).
data/animacoes.json

# Conta da live do streamer: configuração de INSTALAÇÃO, não do produto. Cada
# máquina tem a sua, e o @ de quem instalou não pertence ao repositório. Mesma
# lógica do catálogo coletado acima.
data/configuracao.json

# Entrada temporária do gate do painel (scripts/verificar-painel.mjs).
panel/src/gate-gerado.jsx
