{
  "name": "kora-stream-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contratos do Bloco 0: JSON Schemas, acervo, semente de catálogo e fixtures. Os três processos (bridge/, panel/, game/) têm package próprio.",
  "scripts": {
    "start": "node scripts/subir-tudo.mjs",
    "dev": "node scripts/subir-tudo.mjs",
    "atalho": "node scripts/criar-atalho.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"bridge/test/**/*.test.mjs\" \"panel/test/**/*.test.mjs\" \"console/test/**/*.test.mjs\"",
    "validar": "node scripts/validar-contratos.mjs",
    "gerar": "node scripts/gerar-animacoes.mjs && node scripts/gerar-tokens.mjs && node scripts/gerar-i18n.mjs",
    "pretest": "node scripts/gerar-animacoes.mjs --silencioso && node scripts/gerar-tokens.mjs --silencioso && node scripts/gerar-i18n.mjs --silencioso",
    "ponte": "node --env-file=.env bridge/src/index.mjs",
    "semear": "node scripts/semear-dev.mjs",
    "acervo:previa": "node scripts/previa-acervo.mjs",
    "luau": "node scripts/verificar-luau.mjs",
    "sondar": "node scripts/sondar-localhost.mjs",
    "vistoria": "node scripts/verificar-estudio.mjs",
    "maratona": "node scripts/maratona.mjs",
    "gemini": "node scripts/verificar-gemini.mjs",
    "painel": "npm run dev --workspace @kora/painel",
    "build:painel": "npm run build --workspace @kora/painel",
    "painel:gate": "node scripts/verificar-painel.mjs",
    "empacotar": "node scripts/empacotar.mjs",
    "icone": "node scripts/gerar-icone.mjs",
    "console": "npm run dev --workspace @kora/console"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "rolldown": "1.2.6"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "bridge",
    "panel",
    "console"
  ]
}
