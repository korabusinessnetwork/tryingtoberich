# Ponte
BRIDGE_TOKEN=troque_por_32_bytes_aleatorios
TIKTOK_USERNAME=seu_usuario_sem_arroba

# DUAS portas, de propósito. O túnel aponta para BRIDGE_PORT e só para ela; o
# painel vive noutra porta e por isso não é alcançável pelo túnel nem se ele
# for configurado apontando para a raiz. Ver docs/11_SEGURANCA, camada 1.
BRIDGE_PORT=8787
PAINEL_PORT=8788

# Bind dos dois servidores. NUNCA 0.0.0.0.
BRIDGE_HOST=127.0.0.1

# IA (só o processo Node lê isto)
GEMINI_API_KEY=

# Open Cloud do Roblox — sobe as imagens do acervo e devolve o assetId.
# GRÁTIS: upload de imagem não gasta Robux. Opcional: sem isto, o painel só
# não consegue publicar o acervo sozinho; o resto do produto não depende.
#
# Como obter, uma vez só:
#   1. create.roblox.com/dashboard/credentials -> "Create API Key"
#   2. Adicione a API System "Assets" com as permissões read e write
#   3. Em "Accepted IP Addresses" ponha 0.0.0.0/0 (roda da sua máquina)
#   4. Copie a chave AQUI. Ela não aparece de novo.
# O CREATOR_ID é o número do seu perfil: roblox.com/users/SEU_ID/profile
ROBLOX_API_KEY=
ROBLOX_CREATOR_ID=

# A base da Kora: licença, telemetria e saúde de conexão (ADR-P02).
#
# OPCIONAIS. Sem as duas o produto funciona INTEIRO em modo local: a licença
# fica "indeterminada", a telemetria fica na sua máquina e nada quebra. Nenhuma
# chamada daqui entra no caminho do presente — a licença é consultada uma vez,
# no arranque, e a telemetria é fire-and-forget (CLAUDE.md, Princípio nº 1).
#
# A ANON_KEY é pública por definição (ela vai em toda instalação) e não dá
# acesso a nada: quem separa um streamer do outro é o RLS do Postgres. Ver
# data/supabase/001-esquema.sql. A chave de SERVIÇO não entra aqui e não entra
# no produto — ela é do console da Kora.
#
# Como obter, uma vez só:
#   1. supabase.com -> New project (tier gratuito, US$ 0)
#   2. Rode data/supabase/001-esquema.sql no SQL Editor
#   3. Project Settings -> API: copie "Project URL" e a chave "anon public"
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SÓ PARA O CONSOLE DA KORA. Não entra no produto do cliente.
#
# A chave de serviço IGNORA o RLS: com ela se lê a lista inteira de assinantes,
# com e-mail. Ela vive no processo Node do console e nunca chega ao navegador
# (nada de VITE_*, que vai para o bundle e é público por definição).
#
# Sem ela, o console sobe com dado de exemplo e diz isso na tela.
SUPABASE_SERVICE_KEY=

# Lemon Squeezy, a fonte da verdade do dinheiro (ADR-P02). Também só do console.
# O segredo do WEBHOOK não mora aqui: ele vive no `supabase secrets`, porque
# quem confere a assinatura é a função de borda.
LEMON_API_KEY=

# Os `variant_id` de cada plano no catalogo da Lemon Squeezy. Sem eles o
# adaptador real RECUSA a troca de plano, com `sem_configuracao`, em vez de
# chutar um id e mudar o cliente para o produto errado. Recusar e o
# comportamento certo: errar aqui cobra o valor errado de quem pagou.
LEMON_VARIANTE_MENSAL=
LEMON_VARIANTE_ANUAL=

# A variante do PACK, a compra unica. Ela nao mora aqui: mora no
# `supabase secrets`, como LEMON_VARIANTES_PACK, porque quem precisa dela e a
# funcao de borda que recebe o webhook, e nao o console.
#
# Sem ela a funcao IGNORA toda compra avulsa, e isso e de proposito: o evento
# `order_created` dispara tambem na assinatura nova, junto do
# `subscription_created`, e contar os dois dobraria a venda no mes. Ignorar
# perde uma linha do relatorio; contar errado inventa receita.

# Long-poll
LONGPOLL_TIMEOUT_MS=20000

# Teto de espera do combate de presentes (ADR-012). Passado isso, o líquido da
# disputa é aplicado com efeito curto, sem animação completa.
COMBATE_MAX_MS=2000

# Painel. Deixe COMENTADO no uso normal: o servidor do Vite encaminha /api para
# a ponte (ver panel/vite.config.js), e o painel fala com a própria origem.
# Preencher isto faz o navegador ver duas origens diferentes e bloquear tudo
# por CORS antes de qualquer requisição sair.
# Nenhuma chave de API entra aqui — o bundle do Vite é público por definição.
# VITE_BRIDGE_URL=
